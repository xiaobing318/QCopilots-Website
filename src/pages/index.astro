---
import { route } from '../lib/site.mjs';
const zh = route('zh');
const en = route('en');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>QCopilots</title>
    <script is:inline define:vars={{ zh, en }}>
      let preferred = 'zh';
      try {
        preferred = localStorage.getItem('qcopilots-locale') || 'zh';
      } catch {}
      location.replace((preferred === 'en' ? en : zh) + location.hash);
    </script>
    <noscript>
      <meta http-equiv="refresh" content={`0;url=${zh}`} />
    </noscript>
  </head>
  <body>
    <main>
      <h1>QCopilots</h1>
      <a href={zh} lang="zh-CN">
        简体中文
      </a>{' '}
      ·{' '}
      <a href={en} lang="en">
        English
      </a>
    </main>
  </body>
</html>

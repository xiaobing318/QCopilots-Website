---
import { route } from '../lib/site.mjs';
const zh = route('zh');
const en = route('en');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#faf9f5" />
    <title>QCopilots</title>
    <script is:inline define:vars={{ zh, en }}>
      // A remembered choice wins. Otherwise follow the browser: Chinese for zh-*, English for others.
      let preferred = '';
      try {
        preferred = localStorage.getItem('qcopilots-locale') || '';
      } catch {}
      if (preferred !== 'zh' && preferred !== 'en') {
        const languages = navigator.languages?.length ? navigator.languages : [navigator.language];
        const first = (languages.find(Boolean) || 'zh').toLowerCase();
        preferred = first.startsWith('zh') ? 'zh' : 'en';
      }
      location.replace((preferred === 'en' ? en : zh) + location.search + location.hash);
    </script>
    <noscript>
      <meta http-equiv="refresh" content={`0;url=${zh}`} />
    </noscript>
    <style>
      body {
        display: grid;
        min-height: 100vh;
        place-items: center;
        margin: 0;
        background: #faf9f5;
        color: #3b3832;
        font-family: system-ui, sans-serif;
      }
      a {
        color: #9e4a2b;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>QCopilots</h1>
      <a href={zh} lang="zh-CN">
        简体中文
      </a>
      ·
      <a href={en} lang="en">
        English
      </a>
    </main>
  </body>
</html>

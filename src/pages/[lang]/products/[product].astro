---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Icon from '../../../components/Icon.astro';
import { products, type Locale } from '../../../content/products';
import { ui } from '../../../content/ui';
import { asset, route } from '../../../lib/site.mjs';
export function getStaticPaths() {
  return ['zh', 'en'].flatMap((lang) =>
    products.map((product) => ({ params: { lang, product: product.id }, props: { product } })),
  );
}
const { product } = Astro.props;
const locale = Astro.params.lang as Locale;
const p = product.locales[locale];
const t = ui[locale];
const isSearch = product.id === 'qcopilots-search';
---

<SiteLayout
  locale={locale}
  title={p.seoTitle}
  description={p.seoDescription}
  slug={`products/${product.id}`}
>
  <div class:list={['product-page', { 'search-product': isSearch }]}>
    <section class="product-hero container">
      <a class="back-link" href={`${route(locale)}#products`}>
        {t.common.backToProducts}
      </a>
      <div class="product-heading">
        <img src={asset(product.icon)} alt="" width="64" height="64" />
        <span>{p.name}</span>
      </div>
      <p class="eyebrow">{p.eyebrow}</p>
      <h1>{p.tagline}</h1>
      <p class="product-lead">{p.description}</p>
      <div class="hero-buttons">
        <a class="button" href="#downloads">
          {t.common.viewDownloads}
          <Icon name="download" />
        </a>
        <a class="text-link" href="#workflow">
          {t.common.workflow}
          <Icon />
        </a>
      </div>
      <figure class="product-hero-visual">
        <img
          src={asset(product.heroImage)}
          width="1586"
          height="992"
          alt={p.heroAlt}
          fetchpriority="high"
        />
        <figcaption>{t.common.illustration}</figcaption>
      </figure>
    </section>
    <nav class="product-subnav" aria-label={p.name}>
      <div class="container">
        <a href="#features">{t.common.features}</a>
        <a href="#workflow">{t.common.workflow}</a>
        <a href="#use-cases">{t.common.useCases}</a>
        <a href="#faq">{t.common.faq}</a>
        <a href="#downloads">{t.common.downloads}</a>
      </div>
    </nav>
    <section id="features" class="section container">
      <div class="section-intro">
        <p class="eyebrow">{p.name}</p>
        <h2>{t.common.features}</h2>
      </div>
      <div class="benefit-grid">
        {p.benefits.map((item, index) => (
          <article>
            <div class="benefit-icon">
              <Icon
                name={
                  isSearch
                    ? index === 0
                      ? 'search'
                      : index === 1
                        ? 'layers'
                        : 'check'
                    : index === 0
                      ? 'layers'
                      : index === 1
                        ? 'pin'
                        : 'check'
                }
              />
            </div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </section>
    <section id="workflow" class="workflow-surface">
      <div class="section container">
        <div class="section-intro">
          <p class="eyebrow">{t.common.workflowEyebrow}</p>
          <h2>{t.common.workflow}</h2>
        </div>
        <ol class="steps">
          {p.steps.map((item, index) => (
            <li>
              <span class="step-number">0{index + 1}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
    <section id="use-cases" class="section container">
      <div class="section-intro">
        <p class="eyebrow">{t.common.useCasesEyebrow}</p>
        <h2>{t.common.useCases}</h2>
      </div>
      <div class="usecase-list">
        {p.useCases.map((item) => (
          <article>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
      <aside class="model-notice">
        <Icon name="check" />
        <div>
          <h3>{t.common.modelNoticeTitle}</h3>
          <p>{p.modelNotice}</p>
        </div>
      </aside>
    </section>
    <section id="faq" class="section container faq-section">
      <div class="section-intro">
        <p class="eyebrow">{p.name}</p>
        <h2>{t.common.faq}</h2>
      </div>
      <div class="faq-list">
        {p.faq.map((item) => (
          <details>
            <summary>
              {item.question}
              <Icon name="plus" />
            </summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
    <section id="downloads" class="download-surface">
      <div class="section container">
        <div class="section-intro">
          <img class="download-icon" src={asset(product.icon)} alt="" width="64" height="64" />
          <h2>
            {t.common.getProductPrefix} {p.name}
          </h2>
          <p>{p.downloadsDescription}</p>
        </div>
        <div class="download-grid">
          {product.downloads.map((entry) => (
            <article class="download-option">
              <h3>{entry.label[locale]}</h3>
              {(entry.architecture || entry.version || entry.checksum) && (
                <dl class="download-metadata">
                  {entry.architecture && (
                    <div>
                      <dt>{t.common.downloadArchitecture}</dt>
                      <dd>{entry.architecture}</dd>
                    </div>
                  )}
                  {entry.version && (
                    <div>
                      <dt>{t.common.downloadVersion}</dt>
                      <dd>{entry.version}</dd>
                    </div>
                  )}
                  {entry.checksum && (
                    <div>
                      <dt>{t.common.downloadChecksum}</dt>
                      <dd>
                        <code>{entry.checksum}</code>
                      </dd>
                    </div>
                  )}
                </dl>
              )}
              {entry.requirements && <p>{entry.requirements[locale]}</p>}
              {entry.url ? (
                <a
                  class="button"
                  data-testid="download-link"
                  href={entry.url}
                  rel="noopener noreferrer"
                >
                  {t.common.download}
                  <Icon name="download" />
                </a>
              ) : (
                <button
                  class="button button-unavailable"
                  data-testid="download-unavailable"
                  disabled
                >
                  {t.common.downloadSoon}
                </button>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>
</SiteLayout>

---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Demo from '../../../components/demos/Demo.astro';
import Downloads from '../../../components/product/Downloads.astro';
import ExampleList from '../../../components/product/ExampleList.astro';
import FactsBand from '../../../components/product/FactsBand.astro';
import Faq from '../../../components/product/Faq.astro';
import FeatureGrid from '../../../components/product/FeatureGrid.astro';
import PrivacyBand from '../../../components/product/PrivacyBand.astro';
import ProductHero from '../../../components/product/ProductHero.astro';
import ProductSubnav from '../../../components/product/ProductSubnav.astro';
import RelatedProducts from '../../../components/product/RelatedProducts.astro';
import Steps from '../../../components/product/Steps.astro';
import type { Locale, Product } from '../../../content/types.ts';
import { products } from '../../../content/products.ts';
import { locales, themeStyle } from '../../../lib/i18n.ts';

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    products.map((product) => ({
      params: { lang: locale, product: product.id },
      props: { locale, product },
    })),
  );
}

interface Props {
  locale: Locale;
  product: Product;
}
const { locale, product } = Astro.props;
const content = product.locales[locale];
---

<SiteLayout
  locale={locale}
  title={content.seo.title}
  description={content.seo.description}
  slug={`products/${product.id}`}
>
  <div class="product-page" style={themeStyle(product.theme)}>
    <ProductHero product={product} locale={locale} />
    <div class="container product-demo">
      <Demo product={product} locale={locale} />
    </div>
    <ProductSubnav product={product} locale={locale} />
    <FeatureGrid product={product} locale={locale} />
    <ExampleList product={product} locale={locale} />
    <FactsBand product={product} locale={locale} />
    <Steps product={product} locale={locale} />
    <PrivacyBand product={product} locale={locale} />
    <Faq product={product} locale={locale} />
    <Downloads product={product} locale={locale} />
    <RelatedProducts product={product} locale={locale} />
  </div>
</SiteLayout>

<style>
  /* One accent per product page: links, eyebrows and focus rings follow the product colour. */
  .product-page {
    --accent: var(--product-accent);
    --accent-ink: var(--product-accent-ink);
    --focus: var(--product-accent-ink);
  }
  .product-demo {
    max-width: 1080px;
    padding-bottom: var(--section-y);
  }
  :global(html:has(.product-subnav)) {
    scroll-padding-top: calc(var(--header-height, 72px) + 64px);
  }
</style>

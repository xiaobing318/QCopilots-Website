---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { products, type Locale } from '../../content/products';
import { ui } from '../../content/ui';
import { asset, route } from '../../lib/site.mjs';
export function getStaticPaths() {
  return ['zh', 'en'].map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
const t = ui[locale];
---

<SiteLayout locale={locale} title={t.home.seoTitle} description={t.home.seoDescription}>
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="hero-copy container">
      <h1 id="hero-title">
        <span>{t.home.titleLines[0]}</span>
        <span class="accent">{t.home.titleLines[1]}</span>
      </h1>
      <p class="hero-description">{t.home.description}</p>
      <a class="button" href="#products">
        {t.home.primaryCta}
        <Icon />
      </a>
    </div>
    <figure class="hero-map">
      <img
        src={asset('/images/hero-map.webp')}
        width="1942"
        height="809"
        alt={t.home.heroAlt}
        fetchpriority="high"
      />
      <div class="map-prompt" aria-hidden="true">
        <span class="prompt-icon">
          <Icon name="pin" />
        </span>
        <span>{t.home.heroPrompt}</span>
        <span class="prompt-arrow">
          <Icon />
        </span>
      </div>
      <figcaption>{t.common.illustration}</figcaption>
    </figure>
  </section>
  <section id="products" aria-label={t.home.productsTitle}>
    {products.map((product, index) => {
      const p = product.locales[locale];
      return (
        <article
          class:list={[
            'product-feature',
            {
              'product-feature-reverse': index % 2 === 1,
              'search-surface': product.id === 'qcopilots-search',
            },
          ]}
        >
          <div class="container feature-grid">
            <div class="feature-copy">
              <div class="product-identity">
                <img src={asset(product.icon)} alt="" width="76" height="76" />
                <p>{p.name}</p>
              </div>
              <h2>
                <span>{p.homeHeadline[0]}</span>
                <span class="feature-accent">{p.homeHeadline[1]}</span>
              </h2>
              <p class="feature-description">{p.homeDescription}</p>
              <a class="text-link" href={route(locale, `products/${product.id}`)}>
                {locale === 'zh' ? `了解 ${p.name}` : `Explore ${p.name}`}
                <Icon />
              </a>
            </div>
            <figure class="product-visual">
              <a
                href={route(locale, `products/${product.id}`)}
                aria-label={`${t.common.learnMore}: ${p.name}`}
              >
                <img
                  src={asset(product.heroImage)}
                  width="1586"
                  height="992"
                  alt={p.heroAlt}
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <figcaption>{t.common.illustration}</figcaption>
            </figure>
          </div>
        </article>
      );
    })}
  </section>
  <section class="home-scenarios container" id="use-cases" aria-labelledby="scenarios-title">
    <div class="section-intro compact">
      <p class="eyebrow">{t.home.scenariosEyebrow}</p>
      <h2 id="scenarios-title">{t.home.scenariosTitle}</h2>
    </div>
    <div class="scenario-grid">
      {t.home.scenarios.map((item, index) => (
        <a class="scenario" href={`${route(locale, `products/${item.productId}`)}#use-cases`}>
          <span class="scenario-number">0{index + 1}</span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
          <Icon />
        </a>
      ))}
    </div>
  </section>
  <section class="closing container">
    <h2>
      {t.home.closingParts[0]}
      <span class="accent">{t.home.closingParts[1]}</span>
      {t.home.closingParts[2]}
    </h2>
    <a class="text-link" href="#products">
      {t.home.closingCta}
      <Icon />
    </a>
  </section>
</SiteLayout>

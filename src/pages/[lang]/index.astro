---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ClosingCta from '../../components/home/ClosingCta.astro';
import ContactSection from '../../components/home/ContactSection.astro';
import ExampleRows from '../../components/home/ExampleRows.astro';
import HomeHero from '../../components/home/HomeHero.astro';
import PrinciplesBand from '../../components/home/PrinciplesBand.astro';
import ProductCard from '../../components/home/ProductCard.astro';
import SectionIntro from '../../components/SectionIntro.astro';
import type { Locale } from '../../content/types.ts';
import { products } from '../../content/products.ts';
import { ui } from '../../content/ui.ts';
import { locales } from '../../lib/i18n.ts';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { lang: locale }, props: { locale } }));
}

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
---

<SiteLayout locale={locale} title={t.home.seoTitle} description={t.meta.description}>
  <HomeHero locale={locale} />
  <section id="products" class="section family" aria-labelledby="products-title">
    <div class="container">
      <SectionIntro
        id="products-title"
        eyebrow={t.home.familyEyebrow}
        title={t.home.familyTitle}
        lead={t.home.familyLead}
      />
      <div class="product-grid">
        {products.map((product) => (
          <ProductCard product={product} locale={locale} />
        ))}
      </div>
    </div>
  </section>
  <ExampleRows locale={locale} />
  <PrinciplesBand locale={locale} />
  <ContactSection locale={locale} />
  <ClosingCta locale={locale} />
</SiteLayout>

<style>
  .family {
    padding-top: var(--space-6);
  }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 30rem), 1fr));
    gap: var(--space-6);
  }
</style>

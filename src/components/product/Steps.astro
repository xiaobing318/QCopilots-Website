---
import type { Locale, Product } from '../../content/types.ts';
import { ui } from '../../content/ui.ts';
import SectionIntro from '../SectionIntro.astro';
interface Props {
  product: Product;
  locale: Locale;
}
const { product, locale } = Astro.props;
const steps = product.locales[locale].steps;
const t = ui[locale].product;
---

<section id="workflow" class="section band" aria-labelledby="workflow-title">
  <div class="container">
    <SectionIntro id="workflow-title" eyebrow={t.sections.workflow} title={steps.title} />
    <ol class="steps" style={`--count:${steps.items.length}`}>
      {steps.items.map((step, index) => (
        <li>
          <span class="step-number" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-7) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(var(--count), 1fr);
    }
  }
  li {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }
  .step-number {
    color: var(--product-accent);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-style: italic;
    line-height: 1;
  }
  h3 {
    font-size: var(--text-xl);
  }
  p {
    color: var(--text);
  }
</style>

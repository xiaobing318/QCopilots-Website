---
import type { Locale, Product } from '../../content/types.ts';
import { ui } from '../../content/ui.ts';
import { asset, route } from '../../lib/site.mjs';
import Icon from '../Icon.astro';
interface Props {
  product: Product;
  locale: Locale;
}
const { product, locale } = Astro.props;
const content = product.locales[locale];
const t = ui[locale].product;
const available = product.status === 'available';
---

<section id="overview" class="product-hero" aria-labelledby="product-title">
  <div class="container-narrow hero-inner">
    <a class="back-link" href={`${route(locale)}#products`}>
      <Icon name="arrow" class="back-icon" />
      {t.allProducts}
    </a>
    <div class="identity">
      <img
        src={asset(product.icon.src)}
        width={product.icon.width}
        height={product.icon.height}
        alt=""
      />
      <p>
        <span class="product-name">{content.name}</span>
        <span class="category">{content.category}</span>
      </p>
    </div>
    <h1 id="product-title">{content.tagline}</h1>
    <p class="lead">{content.summary}</p>
    <div class="actions">
      <a class="button" href="#downloads">
        {available ? <Icon name="download" /> : null}
        {available ? t.download : t.downloadSoon}
      </a>
      <a class="text-link" href="#use-cases">
        {t.seeExamples}
        <Icon name="arrow" class="icon-arrow" />
      </a>
    </div>
    <p class="hero-meta">
      <span class:list={['status-dot', `status-${product.status}`]} aria-hidden="true"></span>
      <span>{available ? t.available : t.comingSoon}</span>
      <span class="meta-separator" aria-hidden="true">
        ·
      </span>
      <span>{content.card.platforms}</span>
    </p>
  </div>
</section>

<style>
  .product-hero {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2.5rem, 5vw, 4rem);
  }
  .hero-inner {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    text-align: center;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    justify-self: start;
    color: var(--text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .back-link:hover {
    color: var(--ink-900);
  }
  .back-link :global(.back-icon) {
    transform: scaleX(-1);
  }
  .identity {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .identity img {
    width: 56px;
    height: 56px;
  }
  .identity p {
    display: grid;
    text-align: start;
  }
  .product-name {
    color: var(--ink-900);
    font-weight: 600;
  }
  .category {
    color: var(--product-accent-ink);
    font-size: var(--text-sm);
  }
  .lead {
    margin-inline: auto;
  }
  .actions {
    justify-content: center;
  }
  .hero-meta {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  @media (max-width: 520px) {
    /* On phones the status and platforms sit on two lines instead of leaving a stray dot. */
    .meta-separator {
      display: none;
    }
    .hero-meta > span:last-child {
      flex-basis: 100%;
    }
  }
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--product-accent);
  }
  .status-coming-soon {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--product-accent);
  }
</style>

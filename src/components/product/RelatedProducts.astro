---
import type { Locale, Product } from '../../content/types.ts';
import { products } from '../../content/products.ts';
import { ui } from '../../content/ui.ts';
import { themeStyle } from '../../lib/i18n.ts';
import { asset, route } from '../../lib/site.mjs';
import Icon from '../Icon.astro';
interface Props {
  product: Product;
  locale: Locale;
}
const { product, locale } = Astro.props;
const others = products.filter((other) => other.id !== product.id);
const t = ui[locale].product;
---

{others.length > 0 && (
  <section class="section related" aria-labelledby="related-title">
    <div class="container">
      <h2 id="related-title">{t.related}</h2>
      <div class="related-grid">
        {others.map((other) => (
          <a
            class="related-card"
            href={route(locale, `products/${other.id}`)}
            style={themeStyle(other.theme)}
          >
            <img src={asset(other.icon.src)} width="48" height="48" alt="" />
            <span class="related-text">
              <span class="related-name">{other.locales[locale].name}</span>
              <span>{other.locales[locale].card.headline}</span>
            </span>
            <Icon name="arrow" class="icon-arrow" />
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .related {
    padding-bottom: 0;
  }
  h2 {
    margin-bottom: var(--space-6);
    font-size: var(--text-xl);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 26rem), 1fr));
    gap: var(--space-5);
  }
  .related-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--paper);
    color: var(--ink-700);
    text-decoration: none;
    transition: border-color var(--dur-1) var(--ease-out);
  }
  .related-card:hover {
    border-color: var(--product-accent);
  }
  .related-card img {
    width: 48px;
    height: 48px;
  }
  .related-text {
    display: grid;
    flex: 1;
  }
  .related-name {
    color: var(--ink-900);
    font-weight: 600;
  }
  .related-card :global(.icon-arrow) {
    color: var(--product-accent-ink);
  }
  .related-card:hover :global(.icon-arrow) {
    transform: translateX(3px);
  }
</style>

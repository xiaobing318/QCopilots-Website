---
// QGIS with the QCopilots panel docked on the right. Every visible word comes from `copy`.
import type { DemoCopy } from '../../content/types.ts';
import { areas, breaks, outline, size, unitMetres, viewBox } from './geometry/germany-states.ts';
interface Props {
  copy: DemoCopy;
  variant: 'full' | 'thumb';
}
// The thumb variant needs no changes: the card crops the top of scene 0, which reads on its own.
const { copy } = Astro.props;
const label = (key: string) => copy.labels[key] ?? '';

/*
 * The map shows Germany's 16 states from Natural Earth, classed by area. The geometry is
 * generated by scripts/demo-geometry.mjs. Scene order follows the copy:
 * 0 shades and labels the states, 1 lays them out on an A4 page, 2 lists the largest ones.
 */
type Setup = { shade: 'new' | 'on'; overlay?: 'layout' | 'table' };
const setups: Setup[] = [
  { shade: 'new' },
  { shade: 'on', overlay: 'layout' },
  { shade: 'on', overlay: 'table' },
];
const setupFor = (index: number): Setup => setups[index] ?? { shade: 'on' };

// Class 1 is the smallest. Each class has its legend text in labels.class1, class2…
const classes = breaks.slice(1).map((_, index) => index + 1);
// Labels sit centred on their anchor. Long names break after their hyphen: "Nordrhein-" over
// "Westfalen". Each line carries its own offset, the first one lifted by half the extra lines.
const names = areas.flatMap((area) => {
  if (!area.label) return [];
  const parts = area.name.length > 11 ? area.name.split(/(?<=-)/) : [area.name];
  const lines = parts.map((text, position) => ({
    text,
    dy: position ? '1.1em' : `${(parts.length - 1) * -0.55}em`,
  }));
  return [{ name: area.name, ...area.label, lines }];
});
// The scale bar is as long as the distance written in labels.scaleBar, such as "100 km".
const scaleBar = ((parseFloat(label('scaleBar')) || 100) * 1000) / unitMetres;

const tools = [3, 4, 3, 2];
---

<div class="demo-window qc" style="--demo-width: 62">
  <div class="demo-titlebar">
    <span class="demo-title">{copy.windowTitle}</span>
    <span class="demo-controls">
      <i></i>
      <i></i>
      <i></i>
    </span>
  </div>
  <div class="qc-toolbar">
    {tools.map((count) => (
      <span class="qc-tool-group">
        {Array.from({ length: count }, () => (
          <i />
        ))}
      </span>
    ))}
    <span class="qc-tool-group qc-tool-end">
      <i class="qc-tool-active" />
    </span>
  </div>

  {copy.scenes.map((scene, index) => {
    const setup = setupFor(index);
    const steps = scene.steps ?? [];
    const rows = setup.overlay === 'table' ? (scene.rows ?? []) : [];
    // Delays: the query types first, then each step and the reply follow.
    const stepOrder = steps.map((_, position) => position + 2);
    const doneAt = stepOrder[stepOrder.length - 1] ?? 1;
    const replyAt = doneAt + 1;
    const fresh = setup.shade === 'new';
    // The table answers with the largest states, so the map keeps those bright and dims the rest.
    const listed = new Set(areas.slice(0, rows.length).map((area) => area.name));
    const dim = (name: string) => rows.length > 0 && !listed.has(name);
    const layers = [
      { name: label('layerResult'), kind: 'classes', on: true, selected: rows.length > 0 },
      { name: label('layerSource'), kind: 'polygon', on: false },
    ].filter((layer) => layer.name);

    return (
      <div class="qc-body" data-scene={index} hidden={index > 0}>
        <aside class="qc-layers">
          <p class="qc-dock-title">{label('layers')}</p>
          <span class="qc-layers-tools">
            <i />
            <i />
            <i />
            <i />
          </span>
          <ul>
            {layers.map((layer) => (
              <>
                <li
                  class:list={[
                    'qc-layer',
                    layer.kind === 'classes' && fresh && 'qc-layer-new d-in',
                    layer.selected && 'qc-layer-selected',
                  ]}
                  style={layer.kind === 'classes' && fresh ? `--d:${stepOrder[0] ?? 1}` : undefined}
                >
                  <span class:list={['qc-check', layer.on && 'is-on']}>
                    {layer.on && (
                      <svg viewBox="0 0 10 10">
                        <path d="M2.2 5.2 4.2 7.2 7.8 3" />
                      </svg>
                    )}
                  </span>
                  <svg class="qc-swatch" viewBox="0 0 14 14">
                    {layer.kind === 'classes' ? (
                      <>
                        <rect class="qc-c2" x="1" y="1" width="6" height="6" />
                        <rect class="qc-c4" x="7" y="1" width="6" height="6" />
                        <rect class="qc-c1" x="1" y="7" width="6" height="6" />
                        <rect class="qc-c5" x="7" y="7" width="6" height="6" />
                      </>
                    ) : (
                      <rect class="qc-plain" x="1.5" y="2.5" width="11" height="9" rx="1.5" />
                    )}
                  </svg>
                  <span class="qc-layer-name">{layer.name}</span>
                </li>
                {layer.kind === 'classes' &&
                  classes.map((step) => (
                    <li
                      class:list={['qc-class', fresh && 'd-in']}
                      style={fresh ? `--d:${doneAt}` : undefined}
                    >
                      <i class={`qc-key qc-c${step}`} />
                      <span class="qc-layer-name">{label(`class${step}`)}</span>
                    </li>
                  ))}
              </>
            ))}
          </ul>
        </aside>

        <div class:list={['qc-map', rows.length > 0 && 'qc-map-split']}>
          <svg
            class="qc-map-svg"
            viewBox={viewBox}
            style={rows.length > 0 ? `--d:${doneAt}` : undefined}
          >
            <g
              class:list={[fresh && 'qc-fade']}
              style={fresh ? `--d:${stepOrder[0] ?? 1}` : undefined}
            >
              {fresh && <path class="qc-land" d={outline} />}
              <g
                class:list={['qc-states', fresh && 'qc-shade']}
                style={fresh ? `--s:${doneAt}` : undefined}
              >
                {areas.map((area) => (
                  <path
                    class:list={['qc-area', `qc-c${area.cls}`, dim(area.name) && 'qc-dim']}
                    d={area.d}
                  />
                ))}
              </g>
              <path class="qc-outline" d={outline} />
            </g>
            <g
              class:list={['qc-labels', fresh && 'qc-fade']}
              style={fresh ? `--d:${doneAt}` : undefined}
            >
              {names.map((place) => (
                <text class:list={[dim(place.name) && 'qc-dim']} x={place.x} y={place.y}>
                  {place.lines.map((line) => (
                    <tspan x={place.x} dy={line.dy} set:text={line.text} />
                  ))}
                </text>
              ))}
            </g>
          </svg>

          {setup.overlay === 'layout' && (
            <div class="qc-sheet-stage qc-fade" style={`--d:${stepOrder[1] ?? 2}`}>
              <div class="qc-sheet d-in">
                <p class="qc-sheet-title">{label('mapTitle')}</p>
                <div class="qc-sheet-map">
                  <svg viewBox={viewBox}>
                    <g class="qc-states">
                      {areas.map((area) => (
                        <path class:list={['qc-area', `qc-c${area.cls}`]} d={area.d} />
                      ))}
                    </g>
                    <path class="qc-outline" d={outline} />
                    <g class="qc-labels">
                      {names.map((place) => (
                        <text x={place.x} y={place.y}>
                          {place.lines.map((line) => (
                            <tspan x={place.x} dy={line.dy} set:text={line.text} />
                          ))}
                        </text>
                      ))}
                    </g>
                    <g class="qc-scale" transform={`translate(8 ${size.height - 12})`}>
                      <rect class="qc-scale-dark" width={scaleBar / 2} height="3" />
                      <rect
                        class="qc-scale-light"
                        x={scaleBar / 2}
                        width={scaleBar / 2}
                        height="3"
                      />
                      <text x={scaleBar} y="-3.5" set:text={label('scaleBar')} />
                    </g>
                  </svg>
                  <div class="qc-legend">
                    <span class="qc-legend-title">{label('legend')}</span>
                    {classes.map((step) => (
                      <span class="qc-legend-row">
                        <i class={`qc-key qc-c${step}`} />
                        {label(`class${step}`)}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          )}

          {rows.length > 0 && (
            <div class="qc-card d-in" style={`--d:${doneAt}`}>
              <p class="qc-card-title">{label('tableTitle')}</p>
              <ol>
                {rows.map((row, position) => (
                  <li>
                    <i class={`qc-key qc-c${areas[position]?.cls ?? 1}`} />
                    <span class="qc-card-name">{row.label}</span>
                    <span class="qc-card-value">{row.value}</span>
                  </li>
                ))}
              </ol>
            </div>
          )}
        </div>

        <section class="qc-chat">
          <p class="qc-chat-title">
            <svg class="qc-mark" viewBox="0 0 16 16">
              <path d="M8 1.5C8.6 5.4 10.6 7.4 14.5 8 10.6 8.6 8.6 10.6 8 14.5 7.4 10.6 5.4 8.6 1.5 8 5.4 7.4 7.4 5.4 8 1.5Z" />
            </svg>
            <span>{label('panel')}</span>
            <span class="qc-chat-controls">
              <i />
              <i />
            </span>
          </p>
          <div class="qc-thread">
            <p class="qc-user">
              <span class="d-type">{scene.query}</span>
            </p>
            {steps.length > 0 && (
              <ol class="qc-steps qc-fade" style={`--d:${stepOrder[0]}`}>
                {steps.map((step, position) => (
                  <li class="qc-step d-in" style={`--d:${stepOrder[position]}`}>
                    <svg class="qc-step-icon" viewBox="0 0 16 16">
                      <circle class="qc-done-ring" cx="8" cy="8" r="6.6" />
                      <path class="qc-done-mark" d="M5 8.2 7.1 10.2 11 6" />
                    </svg>
                    <span class="qc-step-body">{step}</span>
                  </li>
                ))}
              </ol>
            )}
            {scene.reply && (
              <p class="qc-reply d-in" style={`--d:${replyAt}`}>
                {scene.reply}
              </p>
            )}
          </div>
          <div class="qc-composer">
            <span>{copy.placeholder}</span>
            <span class="qc-send">
              <svg viewBox="0 0 16 16">
                <path d="M8 12.5v-9M4.2 7.2 8 3.4l3.8 3.8" />
              </svg>
            </span>
          </div>
          <p class="qc-status">
            <i />
            {label('status')}
          </p>
        </section>
      </div>
    );
  })}
</div>

<style>
  /*
   * Five area classes from pale to deep, all from the product accent, in roughly even steps of
   * lightness. The palest class is still clearly tinted, so the small states never read as holes.
   * Map areas, the layer swatch, legend keys and table keys all use these classes.
   */
  .qc {
    --qc-c1: color-mix(in srgb, var(--product-accent) 28%, var(--paper));
    --qc-c2: color-mix(in srgb, var(--product-accent) 50%, var(--paper));
    --qc-c3: color-mix(in srgb, var(--product-accent) 74%, var(--paper));
    --qc-c4: var(--product-accent);
    --qc-c5: var(--product-accent-ink);
    --qc-edge: color-mix(in srgb, var(--product-accent-ink) 60%, var(--ink-900));
  }
  /* Each class colours map areas (fill) and legend keys (background). */
  .qc-c1 {
    fill: var(--qc-c1);
    background: var(--qc-c1);
  }
  .qc-c2 {
    fill: var(--qc-c2);
    background: var(--qc-c2);
  }
  .qc-c3 {
    fill: var(--qc-c3);
    background: var(--qc-c3);
  }
  .qc-c4 {
    fill: var(--qc-c4);
    background: var(--qc-c4);
  }
  .qc-c5 {
    fill: var(--qc-c5);
    background: var(--qc-c5);
  }

  /* Toolbar: a quiet hint of QGIS, with the QCopilots button switched on at the end. */
  .qc-toolbar {
    display: flex;
    height: 2.3em;
    align-items: center;
    gap: 0.9em;
    padding: 0 0.9em;
    border-bottom: 1px solid var(--line);
    background: var(--ivory-50);
  }
  .qc-tool-group {
    display: flex;
    gap: 0.4em;
    padding-right: 0.9em;
    border-right: 1px solid var(--line);
  }
  .qc-tool-group i,
  .qc-layers-tools i,
  .qc-chat-controls i {
    width: 1em;
    height: 1em;
    border-radius: 0.25em;
    background: var(--oat-200);
  }
  .qc-tool-end {
    margin-left: auto;
    padding-right: 0;
    border-right: 0;
  }
  .qc-tool-group .qc-tool-active {
    box-shadow: inset 0 0 0 1px var(--product-accent);
    background: var(--product-wash);
  }

  .qc-body {
    display: grid;
    height: 30em;
    grid-template-columns: 11.5em minmax(0, 1fr) 21em;
  }

  /* Layers panel */
  .qc-layers {
    overflow: hidden;
    border-right: 1px solid var(--line);
    background: var(--ivory-50);
    font-size: 0.76em;
  }
  .qc-dock-title,
  .qc-chat-title {
    display: flex;
    height: 2.6em;
    align-items: center;
    gap: 0.5em;
    margin: 0;
    padding: 0 1em;
    border-bottom: 1px solid var(--line);
    color: var(--ink-700);
    font-weight: 600;
    white-space: nowrap;
  }
  .qc-layers-tools {
    display: flex;
    gap: 0.45em;
    padding: 0.6em 1em;
  }
  .qc-layers-tools i {
    width: 0.95em;
    height: 0.95em;
  }
  .qc-layers ul {
    display: grid;
    gap: 0.1em;
    margin: 0;
    padding: 0 0.45em;
    list-style: none;
  }
  .qc-layer {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.38em 0.55em;
    border-radius: 0.45em;
    color: var(--ink-700);
    white-space: nowrap;
  }
  .qc-layer-new,
  .qc-layer-selected {
    background: var(--product-wash);
    color: var(--ink-900);
  }
  .qc-layer-name {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* The class list under the layer, as QGIS shows a graduated style. */
  .qc-class {
    display: flex;
    align-items: center;
    gap: 0.55em;
    padding: 0.12em 0.55em 0.12em 2.3em;
    color: var(--ink-700);
    font-size: 0.92em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .qc-class + .qc-layer {
    margin-top: 0.3em;
  }
  .qc-check {
    display: grid;
    width: 1.05em;
    height: 1.05em;
    flex: none;
    place-items: center;
    border: 1px solid var(--oat-300);
    border-radius: 0.25em;
    background: var(--paper);
  }
  .qc-check.is-on {
    border-color: var(--product-accent-ink);
    background: var(--product-accent-ink);
  }
  .qc-check svg {
    width: 0.85em;
    height: 0.85em;
    fill: none;
    stroke: var(--paper);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }
  .qc-swatch {
    width: 1.2em;
    height: 1.2em;
    flex: none;
  }
  .qc-plain {
    fill: var(--paper);
    stroke: var(--oat-300);
  }
  .qc-key {
    width: 1.1em;
    height: 0.8em;
    flex: none;
    border-radius: 0.15em;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink-900) 8%, transparent);
  }

  /* Map canvas */
  .qc-map {
    position: relative;
    overflow: hidden;
    background: var(--ivory-100);
  }
  .qc-map-svg {
    position: absolute;
    inset: 0.9em;
    width: calc(100% - 1.8em);
    height: calc(100% - 1.8em);
    max-width: none;
  }
  /* Room for the answer table on the right: its width plus inset, 14.6em in all. */
  .qc-map-split .qc-map-svg {
    width: calc(100% - 16em);
  }
  .qc-area {
    fill-rule: evenodd;
    stroke: var(--paper);
    stroke-linejoin: round;
    stroke-width: 0.7;
  }
  .qc-land {
    fill: var(--paper);
    fill-rule: evenodd;
  }
  .qc-outline {
    fill: none;
    stroke: var(--qc-edge);
    stroke-linejoin: round;
    stroke-width: 0.9;
  }
  .qc-labels text {
    fill: var(--ink-900);
    stroke: var(--paper);
    stroke-linejoin: round;
    stroke-width: 2.4px;
    font-family: var(--font-body);
    font-size: 8.4px;
    font-weight: 600;
    paint-order: stroke;
    text-anchor: middle;
    dominant-baseline: central;
  }
  .qc-dim {
    opacity: 0.32;
  }

  /* Print layout preview: an A4 portrait page */
  .qc-sheet-stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--ivory-100) 62%, transparent);
  }
  .qc-sheet {
    display: grid;
    width: auto;
    height: 90%;
    aspect-ratio: 210 / 297;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 0.45em;
    padding: 0.8em 0.7em 0.7em;
    border: 1px solid var(--line);
    border-radius: 0.2em;
    background: var(--paper);
    box-shadow: var(--shadow-2);
    color: var(--ink-700);
  }
  .qc-sheet-title {
    margin: 0;
    color: var(--ink-900);
    font-family: var(--font-display);
    font-size: 0.8em;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
  }
  .qc-sheet-map {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--oat-300);
  }
  .qc-sheet-map svg {
    position: absolute;
    inset: 0.3em;
    width: calc(100% - 0.6em);
    height: calc(100% - 0.6em);
    max-width: none;
  }
  .qc-scale rect {
    stroke: var(--ink-700);
    stroke-width: 0.5;
  }
  .qc-scale-dark {
    fill: var(--ink-700);
  }
  .qc-scale-light {
    fill: var(--paper);
  }
  .qc-scale text {
    fill: var(--ink-700);
    font-family: var(--font-body);
    font-size: 7.5px;
    text-anchor: end;
  }
  .qc-legend {
    position: absolute;
    top: 0.9em;
    left: 0.9em;
    display: grid;
    gap: 0.3em;
    padding: 0.6em 0.75em;
    border: 1px solid var(--line);
    background: var(--paper);
    font-size: 0.46em;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }
  .qc-legend-title {
    color: var(--ink-900);
    font-weight: 600;
  }
  .qc-legend-row {
    display: flex;
    align-items: center;
    gap: 0.5em;
    white-space: nowrap;
  }

  /* Answer table beside the map */
  .qc-card {
    position: absolute;
    inset: 0 1.2em 0 auto;
    width: 19em;
    height: fit-content;
    margin-block: auto;
    padding: 0.85em 1em 0.95em;
    border: 1px solid var(--line);
    border-radius: 0.7em;
    background: var(--paper);
    box-shadow: var(--shadow-2);
    font-size: 0.72em;
  }
  .qc-card-title {
    margin: 0 0 0.6em;
    color: var(--ink-900);
    font-weight: 600;
  }
  .qc-card ol {
    display: grid;
    gap: 0.4em;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .qc-card li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.6em;
  }
  .qc-card-name {
    overflow: hidden;
    color: var(--ink-700);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .qc-card-value {
    color: var(--ink-900);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    white-space: nowrap;
  }

  /* QCopilots panel */
  .qc-chat {
    display: flex;
    min-width: 0;
    flex-direction: column;
    border-left: 1px solid var(--line);
    background: var(--paper);
  }
  .qc-chat-title {
    font-size: 0.76em;
    color: var(--ink-900);
  }
  .qc-mark {
    width: 1.15em;
    height: 1.15em;
    fill: var(--product-accent);
  }
  .qc-chat-controls {
    display: flex;
    gap: 0.6em;
    margin-left: auto;
  }
  .qc-chat-controls i {
    width: 0.8em;
    height: 0.8em;
  }
  .qc-thread {
    display: flex;
    min-height: 0;
    flex: 1;
    flex-direction: column;
    gap: 0.85em;
    overflow: hidden;
    padding: 1.05em 1em 0.8em;
    font-size: 0.8em;
    line-height: 1.5;
  }
  .qc-user,
  .qc-reply {
    margin: 0;
    padding: 0.6em 0.9em;
    color: var(--ink-900);
  }
  .qc-user {
    max-width: 90%;
    align-self: flex-end;
    border-radius: 1.1em 1.1em 0.35em 1.1em;
    background: var(--ivory-100);
  }
  .qc-user .d-type {
    display: block;
  }
  .qc-steps {
    display: grid;
    gap: 0.55em;
    margin: 0;
    padding: 0.75em 0.85em;
    border: 1px solid var(--line);
    border-radius: 0.85em;
    background: var(--ivory-50);
    list-style: none;
    font-size: 0.94em;
  }
  .qc-step {
    display: grid;
    grid-template-columns: 1.2em minmax(0, 1fr);
    align-items: start;
    gap: 0.55em;
    color: var(--ink-700);
  }
  .qc-step-icon {
    width: 1.2em;
    height: 1.2em;
    margin-top: 0.15em;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .qc-done-ring {
    fill: var(--product-wash);
    stroke: none;
  }
  .qc-done-mark {
    stroke: var(--product-accent-ink);
    stroke-width: 1.6;
  }
  .qc-step-body {
    display: grid;
    gap: 0.45em;
    justify-items: start;
  }
  .qc-reply {
    max-width: 94%;
    align-self: flex-start;
    border-radius: 1.1em 1.1em 1.1em 0.35em;

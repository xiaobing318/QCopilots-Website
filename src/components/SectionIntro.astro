---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  id?: string;
  align?: 'start' | 'center';
  level?: 'h2' | 'h3';
}
const { eyebrow, title, lead, id, align = 'start', level = 'h2' } = Astro.props;
const Heading = level;
---

<div class:list={['section-intro', `align-${align}`]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Heading id={id}>{title}</Heading>
  {lead && <p class="lead">{lead}</p>}
</div>

<style>
  .section-intro {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  .section-intro .eyebrow {
    margin: 0;
  }
  .align-center {
    justify-items: center;
    text-align: center;
  }
  .align-center .lead {
    margin-inline: auto;
  }
  h2 {
    max-width: 18em;
  }
</style>

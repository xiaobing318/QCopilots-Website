{
	admin off
	{$ACME_EMAIL_CONFIG}
}

# A container-only probe checks the exact static build without public routing.
:2016 {
	bind 127.0.0.1
	root * /srv{$SITE_BASE_PATH:/}
	file_server
}

{$SITE_ADDRESS::80} {
	root * /srv
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	@assets path */_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	file_server
	handle_errors {
		root * /srv{$SITE_BASE_PATH:/}
		rewrite * /404.html
		file_server
	}
}

{
  "name": "qcopilots-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11.19.1 <12"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check && node scripts/check-content.mjs",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --test tests/unit/*.test.mjs",
    "test:built": "node scripts/verify-build.mjs",
    "test:e2e": "playwright test",
    "test:live": "playwright test --config playwright.live.config.ts",
    "test:native": "node --test tests/native/*.test.mjs && node tests/native-smoke.mjs",
    "test:container": "node tests/container-smoke.mjs",
    "package": "node scripts/package.mjs",
    "site": "node scripts/site.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@phosphor-icons/core": "2.1.1",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "parse5": "8.0.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "tar": "7.5.22",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
